{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "nursery": {
        "useSortedClasses": {
          "level": "warn",
          "fix": "safe",
          "options": {
            "attributes": ["classList", "tw", "className", "class"],
            "functions": ["tw", "cn", "tv"]
          }
        }
      }
    },
    "ignore": ["node_modules", "dist", ".vercel", ".vscode", ".react-router"]
  },
  "formatter": {
    "enabled": true,
    "lineWidth": 88,
    "indentStyle": "space",
    "ignore": ["node_modules", "dist", ".vercel", ".vscode", ".react-router"]
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  }
}
